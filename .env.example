# Telegram delivery. Create a NEW bot token with BotFather; never reuse a token pasted in chat.
TELEGRAM_BOT_TOKEN=

# Destination chat for booking requests. The bot must be a member of this chat.
TELEGRAM_CHAT_ID=-1003887700261

# Webhook mode only: random secret (e.g. `openssl rand -hex 32`), passed as secret_token to setWebhook.
# On the published app the webhook is registered automatically (see README). If empty, only local getUpdates polling is available.
TELEGRAM_WEBHOOK_SECRET=

# Optional: set to `off` to disable polling.
# TELEGRAM_POLLING=

# Optional: public base URL for the webhook (default https://paris-photographer.apps.grok.bot) or a full TELEGRAM_WEBHOOK_URL.
# APP_PUBLIC_URL=
# Auto setWebhook runs only on the published host (CURSOR_APP_ID set) or when TELEGRAM_AUTO_WEBHOOK=on; `off` disables it.
# TELEGRAM_AUTO_WEBHOOK=

# Optional. Defaults to 4173.
PORT=4173

# Optional, tests only: point the server at a mock Telegram API.
# TELEGRAM_API_BASE=http://127.0.0.1:4299
